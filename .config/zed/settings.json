{
  "disable_ai": true,
  "restore_on_startup": "empty_tab",
  "cli_default_open_behavior": "existing_window",
  "use_system_path_prompts": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "theme": "Base16 Black Metal",
  "icon_theme": "Zed (Default)",
  "experimental.theme_overrides": {
    "editor.invisible": "#444",
  },

  "ui_font_size": 16,
  "ui_font_features": {
    "calt": false,
  },
  "buffer_font_family": "Lilex",
  "buffer_font_size": 15.5,
  // "buffer_font_weight": 500,
  "buffer_font_features": {
    "calt": false,
  },
  "buffer_line_height": {
    "custom": 1.5,
  },

  "base_keymap": "VSCode",
  "show_whitespaces": "boundary",

  "title_bar": {
    "show_user_menu": false,
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "preview_tabs": {
    "enabled": false,
  },

  "project_panel": {
    "dock": "left",
    "button": false,
    "hide_root": true,
    "auto_fold_dirs": false,
  },
  "outline_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "terminal": {
    "button": false,
  },
  "debugger": {
    "dock": "left",
  },

  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },

  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
}
